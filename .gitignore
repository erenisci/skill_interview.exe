# --- dependencies & build output ---
node_modules/
dist/
out/
release/
build/
*.tsbuildinfo

# --- local data (never commit a real database) ---
.dev-data/
*.db
*.db-journal
*.db-wal
*.sqlite

# --- eval run artefacts ---
# Regenerated by `npm run eval`; the scored record lives in docs/llm/eval-harness.md.
evals/results/

# --- logs ---
logs/
*.log
npm-debug.log*

# --- editor & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini

# --- secrets (none should exist; belt and braces) ---
.env
.env.*
*.pem
*.pfx

# acta:gitignore:start
# Sensitive doc areas stay local. Claude still reads them from disk; git just never sees them.
# Uncomment a line to keep that area private too.

docs/business/
docs/legal/

# The filled-in brief: written in the author's own language for an audience of one, and
# full of raw personal reasoning. The decisions it led to live in the ADRs instead.
docs/_brief-archive/

# Acta's own state — a generated registry table, not a document anyone reads.
.claude/

# docs/product/
# docs/project/
# docs/engineering/
# docs/architecture/
# docs/quality/
# docs/operations/
# docs/ai/
# docs/llm/

# Keep the index and the brain tracked:
!docs/README.md
!CLAUDE.md

# Local working scratchpad — Acta-managed, never committed.
SCRATCH.md
# Playwright output — a report is worth keeping only as a CI artifact on failure.
playwright-report/
test-results/

# acta:gitignore:end
