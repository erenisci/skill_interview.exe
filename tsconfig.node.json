{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    // The eval harness never ships in the app bundle, but it imports the real pipeline —
    // so a change there must break here loudly rather than at `npm run eval` time.
    "evals/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ESNext"
    ]
  }
}